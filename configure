#!/usr/bin/env bash
# ==============================================================================
# 🛠️ JOBBY — CONFIGURATION SCRIPT
# ==============================================================================
# Description : Checks system dependencies, initializes the local .env file,
#               and installs required Node.js modules.
# Author      : Éole <hi@eole.me>
# License     : MIT
# ==============================================================================

# Exit immediately if a command exits with a non-zero status
set -e

# Terminal output styling colors (TrueColor / 24-bit ANSI)
ESC_SEQ="\033["
RESET="${ESC_SEQ}0m"
BOLD="${ESC_SEQ}1m"
DIM="${ESC_SEQ}2m"
ITALIC="${ESC_SEQ}3m"
UNDERLINE="${ESC_SEQ}4m"

GREEN="${ESC_SEQ}38;2;74;222;128m"    # Bright Neon Green
BLUE="${ESC_SEQ}38;2;96;165;250m"     # Sky Blue
YELLOW="${ESC_SEQ}38;2;253;224;71m"   # Yellow
RED="${ESC_SEQ}38;2;244;63;94m"       # Rose Red
ORANGE="${ESC_SEQ}38;2;251;146;60m"   # Soft Orange
PURPLE="${ESC_SEQ}38;2;167;139;250m"  # Pastel Purple
CYAN="${ESC_SEQ}38;2;45;212;191m"     # Teal/Cyan
GRAY="${ESC_SEQ}38;2;156;163;175m"     # Medium Gray
DARK_GRAY="${ESC_SEQ}38;2;75;85;99m"  # Dark Gray

# Logger helper functions
log_success() { echo -e "  ${GREEN}✔${RESET}  $1"; }
log_warn()    { echo -e "  ${YELLOW}⚠${RESET}  $1"; }
log_error()   { echo -e "  ${RED}✘${RESET}  $1"; }
log_info()    { echo -e "  ${BLUE}ℹ${RESET}  $1"; }

print_section() {
    echo ""
    echo -e "  ${BOLD}${PURPLE}❯ $1${RESET}"
    echo -e "  ${DARK_GRAY}────────────────────────────────────────────────────────────${RESET}"
}

# Helper to print perfectly aligned lines inside a box of width 70
print_box_line() {
    local border_color="$1"
    local left_pad="$2"
    local content="$3"
    local max_width=70
    
    # Strip ANSI escape codes using portable sed and printf \033
    local esc
    esc=$(printf '\033')
    local clean_content
    clean_content=$(echo -e "$content" | sed "s/${esc}\[[0-9;]*[a-zA-Z]//g")
    local content_len=${#clean_content}
    
    # Adjust for known 2-column wide characters (like 🛠️, 🐸, 🎭, 🍃)
    local emoji_count
    emoji_count=$(echo "$clean_content" | grep -o -E "🛠️|🐸|🎭|🍃" | wc -l || echo 0)
    content_len=$((content_len + emoji_count))
    
    local pad_len=$((max_width - left_pad - content_len))
    if [ $pad_len -lt 0 ]; then
        pad_len=0
    fi
    
    local spaces=""
    if [ $pad_len -gt 0 ]; then
        spaces=$(printf '%*s' "$pad_len" "")
    fi
    
    local indent=""
    if [ $left_pad -gt 0 ]; then
        indent=$(printf '%*s' "$left_pad" "")
    fi
    
    echo -e "  ${border_color}│${RESET}${indent}${content}${spaces}${border_color}│${RESET}"
}

# Resolve project name dynamically from git remote or directory name
REPO_NAME=$(git config --get remote.origin.url 2>/dev/null | sed 's/.*\///; s/\.git$//')
if [ -z "$REPO_NAME" ]; then
    REPO_NAME=$(basename "$(pwd)")
fi
PROJECT_NAME=$(echo "$REPO_NAME" | cut -d'-' -f1 | sed 's/./\u&/')
PROJECT_NAME_UPPER=$(echo "$PROJECT_NAME" | tr '[:lower:]' '[:upper:]')

# Parse command line options
AUTO_INSTALL=false
for arg in "$@"; do
    case $arg in
        -y|--non-interactive|--auto)
            AUTO_INSTALL=true
            shift
            ;;
    esac
done

echo -e "  ${CYAN}┌──────────────────────────────────────────────────────────────────────┐${RESET}"
print_box_line "${CYAN}" 3 "${BOLD}${GREEN}🛠️  ${PROJECT_NAME_UPPER} 🛠️${RESET} ${BLUE}- SYSTEM CONFIGURATION & INITIALIZATION${RESET}"
echo -e "  ${CYAN}└──────────────────────────────────────────────────────────────────────┘${RESET}"
echo ""

print_section "Verifying system dependencies"


# Node.js
if command -v node >/dev/null 2>&1; then
    NODE_VERSION=$(node -v | cut -d'v' -f2)
    NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d'.' -f1)
    if [ "$NODE_MAJOR" -lt 20 ]; then
        log_warn "Node.js is installed (v$NODE_VERSION) but version 20+ is highly recommended."
    else
        log_success "Node.js is installed: v$NODE_VERSION"
    fi
else
    log_error "Node.js not detected. Please install Node.js v20+ to run the resume editor."
fi

# npm
if command -v npm >/dev/null 2>&1; then
    NPM_VERSION=$(npm -v)
    log_success "npm is installed: v$NPM_VERSION"
else
    log_error "npm not detected."
fi

# Docker
if command -v docker >/dev/null 2>&1; then
    DOCKER_VERSION=$(docker --version | awk '{print $3}' | sed 's/,//')
    log_success "Docker is installed: v$DOCKER_VERSION"
else
    log_warn "Docker not detected. Required for running containerized n8n/Gotenberg stack."
fi

# Docker Compose
if docker compose version >/dev/null 2>&1; then
    log_success "Docker Compose is available (docker compose)"
elif command -v docker-compose >/dev/null 2>&1; then
    log_success "Docker Compose is available (docker-compose)"
else
    log_warn "Docker Compose not detected. Required for starting dev stack containers."
fi

# Python 3
if command -v python3 >/dev/null 2>&1; then
    PYTHON_VERSION=$(python3 --version | awk '{print $2}')
    log_success "Python 3 is installed: v$PYTHON_VERSION"
else
    log_warn "Python 3 not detected. Required for running n8n backup/sync toolkit scripts."
fi

# Doppler CLI
if command -v doppler >/dev/null 2>&1; then
    DOPPLER_VERSION=$(doppler --version | cut -d'v' -f2)
    log_success "Doppler CLI is installed: v$DOPPLER_VERSION"
else
    log_warn "Doppler CLI not detected. Optional but recommended for secret management."
fi

echo ""

print_section "Setting up environment configuration files"


if [ ! -f ".env" ]; then
    log_warn "Local configuration file .env was not found."
    if [ -f "docker/.env.example" ]; then
        cp docker/.env.example .env
        log_success "Initialized .env from docker/.env.example fallback."
        log_info "Please configure your environment secrets inside .env (or configure Doppler)."
    else
        log_error "Configuration template docker/.env.example is missing!"
    fi
else
    log_success "Local configuration file .env is already present."
fi

echo ""

print_section "Installing Node.js package dependencies"
if [ ! -d "node_modules" ]; then
    log_info "Node dependencies (node_modules) are missing."
    if [ "$AUTO_INSTALL" = true ]; then
        log_info "Installing npm packages automatically..."
        npm install
        log_success "npm dependencies installed successfully."
    else
        read -p "Would you like to run 'npm install' now? [Y/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
            log_info "Installing npm packages..."
            npm install
            log_success "npm dependencies installed successfully."
        else
            log_warn "npm installation skipped."
        fi
    fi
else
    log_success "Node dependencies (node_modules) already present."
fi

echo ""

print_section "Summary & Getting Started"
echo -e "  ${GREEN}┌──────────────────────────────────────────────────────────────────────┐${RESET}"
print_box_line "${GREEN}" 3 "${BOLD}${GREEN}✔ ${PROJECT_NAME} configuration completed successfully!${RESET}"
echo -e "  ${GREEN}└──────────────────────────────────────────────────────────────────────┘${RESET}"
echo ""
echo -e "  ${BOLD}${PURPLE}Useful commands to get started:${RESET}"
echo -e "    ${GRAY}•${RESET} Run resume editor locally:        ${GREEN}make dev${RESET} (or ${GREEN}npm run dev${RESET})"
echo -e "    ${GRAY}•${RESET} Start Dev container stack:       ${GREEN}make up${RESET}"
echo -e "    ${GRAY}•${RESET} Stop dev containers:             ${GREEN}make down${RESET}"
echo ""
