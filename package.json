{
  "name": "jobby",
  "version": "1.12.2",
  "description": "Jobby ATS Markdown resume editor",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "lint": "eslint public/**/*.js && prettier --check \"scripts/**/*.js\" \"public/bricks/*.html\"",
    "format": "prettier --write .",
    "validate:i18n": "node scripts/validate_i18n.js",
    "build": "esbuild public/app.js --bundle --minify --outfile=public/dist/app.min.js"
  },
  "keywords": [
    "markdown",
    "resume",
    "ats"
  ],
  "author": "Julien (Éole) Avarre",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "playwright": "^1.61.0",
    "prettier": "^3.3.2",
    "stylelint": "^16.3.1",
    "stylelint-config-standard": "^36.0.0"
  }
}
