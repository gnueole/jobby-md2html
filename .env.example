PORT=3010
NODE_ENV=development
APP_DOMAIN=localhost
DOCKER_NETWORK_NAME=n8n-eole-prod_default
DOCKER_NETWORK_EXTERNAL=false
# Google Tag Configuration
GOOGLE_TAG_ID=G-XXXXXXXXXX

# Telemetry Configuration
N8N_TELEMETRY_WEBHOOK_URL=https://n8n.eole.me/webhook/jobby-telemetry
# /jobby-feedback was retired in July; /feedback is the single intake shared
# by www, improv and jobby.
N8N_FEEDBACK_WEBHOOK_URL=https://n8n.eole.me/webhook/feedback

# Vector Telemetry Destination (production internal or local testing)
VECTOR_TELEMETRY_URL=http://vector:8080
AXIOM_TELEMETRY_DATASET=jobby-telemetry
